# Optional. Without keys the app uses an explicitly labelled local AI assistant.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Aliases OPEN_API_KEY, 11LABS_API_KEY and 11LABS_KEY are supported.

# Low-quality, single-cover generation; cached by content, limited to 4/day/account.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Local reviewer accounts. Override before exposing this service publicly.
SEED_PASSWORD=Pass1234!
